// V-MINE runs an ARM64 Linux guest for the ARM64 Dragonfly server.

// Define the guest architecture
GUEST_ARCH = arm64

ISH_GUEST_DEFINES = GUEST_ARM64=1
GCC_PREPROCESSOR_DEFINITIONS = GUEST_ARM64=1 DEBUG=1

MESON_GUEST_OPTION = -Dguest_arch=arm64

// CI supplies a prepared Alpine ARM64 rootfs through ROOTFS_LOCAL_PATH.
ROOTFS_URL = dl-cdn.alpinelinux.org/alpine/v3.24/releases/aarch64/alpine-minirootfs-3.24.0-aarch64.tar.gz
ROOTFS_ARCH = aarch64
