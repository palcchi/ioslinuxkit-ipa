#include "App.xcconfig"
#include "GuestARM64.xcconfig"
#include "XtermRenderer.xcconfig"

// ARM64 app release version, independent of inherited non-ARM64 targets.
// Use the vendored xterm.js Canvas renderer on iOS ARM64. This avoids the
// Ghostty WebAssembly/WebGL path that can render a blank terminal in WKWebView.
MARKETING_VERSION = 2.1.1
